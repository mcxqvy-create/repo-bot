# Alpaca PAPER credentials only. Never use live credentials.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_API_BASE_URL=https://paper-api.alpaca.markets
APCA_DATA_BASE_URL=https://data.alpaca.markets

# Use at least 32 random characters. cron-job.org puts this value in the
# /api/run URL as ?secret=YOUR_VALUE.
AUTOMATION_SECRET=

# Optional legacy TradingView webhook secret. AUTOMATION_SECRET falls back to
# this value so an existing deployment does not need a new secret immediately.
TRADINGVIEW_WEBHOOK_SECRET=

# Safe defaults. Test with DRY_RUN=true before enabling paper orders.
BOT_ENABLED=false
DRY_RUN=true
ALLOWED_SYMBOL=SPY
MAX_ALERT_AGE_SECONDS=900
MAX_ORDER_QUANTITY=100000

# These defaults reproduce the Pine strategy filters.
MAX_OPENING_RANGE=2.40
MIN_VWAP_DISTANCE=0.05
MAX_VWAP_DISTANCE=0.15
MAX_SIGNAL_DELAY_SECONDS=180
MAX_DATA_LAG_SECONDS=420
CLOSE_BEFORE_MINUTES=5
