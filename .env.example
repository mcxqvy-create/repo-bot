# Alpaca PAPER credentials only. Never use live credentials.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_API_BASE_URL=https://paper-api.alpaca.markets
APCA_DATA_BASE_URL=https://data.alpaca.markets

# Use at least 32 random characters. Put the same value in the TradingView
# webhook URL as ?secret=YOUR_VALUE.
TRADINGVIEW_WEBHOOK_SECRET=

# Safe defaults. Test with DRY_RUN=true before enabling paper orders.
BOT_ENABLED=false
DRY_RUN=true
ALLOWED_SYMBOL=SPY
MAX_ALERT_AGE_SECONDS=900
MAX_ORDER_QUANTITY=100000
